# Prepared manual backup unit. No timer or automatic retention is enabled.
[Unit]
Description=Caucus Pulse verified private local backup

[Service]
Type=oneshot
User=caucus-pulse
Group=caucus-pulse
WorkingDirectory=/opt/caucus-pulse
ExecStart=/opt/node-v24.19.0/bin/node /opt/caucus-pulse/scripts/archive.js backup
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadWritePaths=/opt/caucus-pulse/data
TimeoutStartSec=600
