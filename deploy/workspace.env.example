# Prepared configuration. Values must come from the actual owner Access application.
NODE_ENV=production
PORT=4317
CAUCUS_AUTH_MODE=cloudflare-access
CAUCUS_PUBLIC_ORIGIN=https://pulse.example.com
CAUCUS_ACCESS_TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
CAUCUS_ACCESS_AUDIENCE=REPLACE_WITH_THE_APPLICATION_AUDIENCE_64_HEX_CHARACTERS
CAUCUS_OWNER_EMAIL=owner@example.com
CAUCUS_DB_PATH=/opt/caucus-pulse/data/pulse.sqlite
# Keep X credentials out of this source-controlled example.
# Provision data/secrets/x-bearer-token privately, or use a private runtime secret.
