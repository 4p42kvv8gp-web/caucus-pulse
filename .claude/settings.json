{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Bash",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(node src/*)",
      "Bash(node --use-env-proxy src/*)",
      "Bash(node --test*)",
      "Bash(node --check *)",
      "Bash(node -e *)",
      "Bash(git *)",
      "Bash(python3 *)",
      "Bash(curl *)",
      "Agent",
      "Workflow",
      "Monitor",
      "TaskStop",
      "TaskOutput",
      "TaskList",
      "Skill",
      "ToolSearch",
      "WebSearch",
      "WebFetch",
      "ReadNotifications",
      "SendUserFile",
      "ScheduleWakeup",
      "mcp__github",
      "mcp__Claude_Code_Remote",
      "mcp__Gmail__search_threads",
      "mcp__Gmail__get_thread",
      "mcp__Gmail__get_message",
      "mcp__Gmail__list_labels"
    ]
  },
  "env": {
    "X_PROXY_AUTH": "1",
    "X_LIST_ID": "1841177179872243858"
  }
}
