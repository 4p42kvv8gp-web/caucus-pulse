{
  "name": "caucus-pulse",
  "version": "0.1.0",
  "description": "Permanent corpus + daily topic/strategic-syntax reporting for the House Democratic Caucus on X",
  "type": "module",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "poll": "node --use-env-proxy src/poll.js",
    "backfill": "node --use-env-proxy src/backfill.js",
    "backfill-members": "node --use-env-proxy src/backfill-members.js",
    "quotes-backfill": "node --use-env-proxy src/quotes-backfill.js",
    "authors": "node --use-env-proxy src/authors.js",
    "refresh": "node --use-env-proxy src/refresh.js",
    "classify": "node --use-env-proxy src/classify.js",
    "classify-range": "node --use-env-proxy src/classify-range.js",
    "stories": "node --use-env-proxy src/stories.js",
    "taxonomy-learn": "node --use-env-proxy src/taxonomy-learn.js",
    "corrections": "node src/corrections.js apply",
    "syntax": "node src/syntax.js",
    "incidents": "node --use-env-proxy src/incidents.js",
    "rollup": "node src/rollup.js",
    "report": "node src/report.js",
    "sitedata": "node src/sitedata.js",
    "nightly": "npm run refresh && npm run classify && npm run stories && npm run stories -- --auto-promote --retire && npm run taxonomy-learn -- --apply && npm run corrections && npm run syntax && npm run incidents && npm run rollup && npm run report && npm run sitedata",
    "volume": "node src/volume.js",
    "check-x": "node --use-env-proxy src/check-x-access.js",
    "check-anthropic": "node --use-env-proxy src/check-anthropic-access.js",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "js-yaml": "^4.1.0"
  }
}
