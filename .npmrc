# onnxruntime-node (pulled in by @huggingface/transformers) has a postinstall
# hook that downloads ~300 MB of CUDA binaries on linux/x64 unless told not to.
# Embeddings run on the CPU build that ships inside the package, so skip it.
# (pnpm equivalent on the Codex branch: ignoredBuiltDependencies.)
onnxruntime-node-install-cuda=skip
